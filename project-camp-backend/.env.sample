PORT=3000
SERVER_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

MONGO_URI=mongodb://localhost:27017/projectmanagement

MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=your-mailtrap-user
MAILTRAP_SMTP_PASS=your-mailtrap-pass

# --- Firebase Admin (server-side ID token verification) ---
# Option A: paste the whole service-account JSON on one line
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
#
# Option B: split fields (get these from Firebase Console > Project Settings > Service Accounts > Generate new private key)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Note: password reset and email verification are now handled entirely by
# Firebase Authentication (configure the action URL / templates in the
# Firebase Console under Authentication > Templates), so no backend
# redirect URLs are needed for them anymore.
